# Neon Postgres (or Vercel Postgres) connection string
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Auth.js
AUTH_SECRET="generate with: npx auth secret"
AUTH_URL="https://your-domain.com"
AUTH_TRUST_HOST="true"

# OAuth providers
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# IsThereAnyDeal (steam price-history proxy)
ITAD_API_KEY=""

# Anthropic (Claude) for Sentiment Radar themes and expectation gap. Server-side only; leave empty to switch themes off.
ANTHROPIC_API_KEY=""
# Optional: the model for every Game OS LLM call (default in lib/llm.ts: claude-opus-5-5), e.g. claude-sonnet-5-5
GAMEOS_LLM_MODEL=""
