# Copy to .env.local (gitignored) and fill in. The scripts read this file.

# Neon / Vercel Postgres
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Auth.js
AUTH_SECRET="run: npx auth secret"
AUTH_URL="https://llamagriffin.com"
AUTH_TRUST_HOST="true"

# OAuth (create apps; register redirect URIs on the final domain)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Steam price-history proxy (optional)
ITAD_API_KEY=""

# ---- Cutover tooling (scripts/dns-cloudflare.mjs, scripts/verify.mjs) ----
# Cloudflare API token: Zone:Edit + DNS:Edit + Workers Scripts:Edit for llamagriffin.com
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
# Optional — resolved by name if omitted
CLOUDFLARE_ZONE_ID=""

# The Vercel host the edge router proxies /game-os/* to (no scheme)
VERCEL_ORIGIN="game-os-xxxx.vercel.app"
# The existing origin for everything else (Namecheap)
NAMECHEAP_ORIGIN="68.65.120.165"
